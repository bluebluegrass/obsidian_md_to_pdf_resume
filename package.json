{
  "name": "obsidian-resume-pdf",
  "version": "0.2.0",
  "description": "Obsidian plugin to export structured resume notes to one-page PDF with a bundled native renderer.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check-release": "node scripts/check-release.mjs",
    "generate-sample": "tsx scripts/generate-sample.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.25.1",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
